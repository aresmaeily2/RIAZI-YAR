{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Riazi-Yar Grade 1 Lesson Schema V2",
  "type": "object",
  "required": [
    "lesson_id",
    "lesson_number",
    "chapter_number",
    "title_fa",
    "grade",
    "status",
    "lesson_summary",
    "question_counts_audit",
    "worked_examples",
    "independent_practice_questions",
    "remedial_questions_ref",
    "assessment_questions_ref"
  ],
  "properties": {
    "lesson_id": {
      "type": "string",
      "pattern": "^G1-L[0-9]{2}$"
    },
    "lesson_number": {
      "type": "integer",
      "minimum": 1,
      "maximum": 39
    },
    "chapter_number": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8
    },
    "title_fa": {
      "type": "string",
      "minLength": 3
    },
    "grade": {
      "type": "integer",
      "const": 1
    },
    "status": {
      "type": "object",
      "required": [
        "technical_validation",
        "pedagogical_review",
        "production_readiness",
        "teacher_reviewer_id"
      ],
      "properties": {
        "technical_validation": {
          "enum": [
            "TECH_VALIDATED_PASS",
            "TECH_VALIDATION_FAILED",
            "TECH_PENDING"
          ]
        },
        "pedagogical_review": {
          "enum": [
            "PEDAGOGICAL_PENDING_TEACHER_REVIEW",
            "PEDAGOGICAL_IN_REVIEW",
            "PEDAGOGICAL_REVISION_REQUIRED",
            "PEDAGOGICAL_APPROVED_BY_TEACHER"
          ]
        },
        "production_readiness": {
          "enum": [
            "DRAFT",
            "TECH_READY_AWAITING_PEDAGOGICAL_SIGN_OFF",
            "APPROVED_FOR_PRODUCTION"
          ]
        },
        "teacher_reviewer_id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "lesson_summary": {
      "type": "object",
      "required": [
        "key_concepts",
        "visual_takeaway",
        "parent_tip"
      ],
      "properties": {
        "key_concepts": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 2
        },
        "visual_takeaway": {
          "type": "string"
        },
        "parent_tip": {
          "type": "string"
        }
      }
    },
    "worked_examples": {
      "type": "array",
      "minItems": 2
    },
    "independent_practice_questions": {
      "type": "array",
      "minItems": 30,
      "maxItems": 30
    },
    "remedial_questions_ref": {
      "type": "string"
    },
    "assessment_questions_ref": {
      "type": "string"
    }
  }
}